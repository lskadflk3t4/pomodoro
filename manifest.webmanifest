{
  "id": "./",
  "name": "Pomodoro Studio",
  "short_name": "Pomodoro",
  "description": "Offline Pomodoro timer, task list and 24h day clock with optional cross-device sync.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Add a task",
      "short_name": "Add task",
      "description": "Jump straight to the new-task box",
      "url": "./?action=add-task",
      "icons": [{ "src": "icons/shortcut-add.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Start a round",
      "short_name": "Start round",
      "description": "Start (or resume) a focus round right away",
      "url": "./?action=start-round",
      "icons": [{ "src": "icons/shortcut-start.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] }
}
